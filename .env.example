# Copy to .env and adjust. docker compose reads .env automatically.

# Where the IndPenSim CSV lives. Keeping it outside the OneDrive-synced folder
# stops OneDrive uploading 2.5 GB. Windows example:
# RAW_DATA_DIR=C:/data/indpensim
RAW_DATA_DIR=./data/raw

# Optional: raises openFDA's daily request quota (free key from open.fda.gov)
OPENFDA_API_KEY=

# Pinned versions (change together; Delta must match the Spark minor version)
REDPANDA_VERSION=v25.3.11
CONSOLE_VERSION=v3.12.0
SPARK_IMAGE_TAG=4.0.4-java21-python3
SPARK_VERSION=4.0.4
DELTA_VERSION=4.0.1
SPARK_DRIVER_MEMORY=2g
AIRFLOW_VERSION=3.3.2-python3.12

# Group that owns /var/run/docker.sock, so Airflow can start task containers.
# Docker Desktop (Windows/Mac): 0. Linux: run `getent group docker | cut -d: -f3`.
DOCKER_GID=0
