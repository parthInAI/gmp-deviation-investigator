# Copy to .env and adjust. docker compose reads .env automatically.

# Where the IndPenSim CSV lives. Keeping it outside the OneDrive-synced folder
# stops OneDrive uploading 2.5 GB. Windows example:
# RAW_DATA_DIR=C:/data/indpensim
RAW_DATA_DIR=./data/raw

# Optional: raises openFDA's daily request quota (free key from open.fda.gov)
OPENFDA_API_KEY=

# Pinned versions (change together; Delta must match the Spark minor version)
REDPANDA_VERSION=v25.3.11
CONSOLE_VERSION=v3.12.0
SPARK_IMAGE_TAG=4.0.4-java21-python3
SPARK_VERSION=4.0.4
DELTA_VERSION=4.0.1
SPARK_DRIVER_MEMORY=2g
AIRFLOW_VERSION=3.3.2-python3.12

# Group that owns /var/run/docker.sock, so Airflow can start task containers.
# Docker Desktop (Windows/Mac): 0. Linux: run `getent group docker | cut -d: -f3`.
DOCKER_GID=0

# ---- Phase 4: agents. Keys live only in your local .env, never in git or chat. ----
# Anthropic (agents: analyst, writer, case historian) and Mistral (reviewer: a different vendor).
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# LangSmith tracing of every agent run (free developer tier at smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gmpdi-phase4
# Signs reviewer decisions in the audit trail. Any long random string; keep it stable.
# PowerShell: [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
GMPDI_AUDIT_KEY=
# crew = CrewAI + Claude (default); search = no LLM for the case historian
CASE_HISTORIAN_MODE=crew
