# Case historian (CrewAI) behind an A2A endpoint. Separate image: CrewAI pins its own dependencies.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app
WORKDIR /app

COPY agents/case_history/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY agents/__init__.py ./agents/__init__.py
COPY agents/case_history ./agents/case_history

EXPOSE 8103
CMD ["python", "-m", "agents.case_history.server"]
