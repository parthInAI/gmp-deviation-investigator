{
  // Run any of these from VS Code: Ctrl+Shift+P -> "Tasks: Run Task".
  // Everything runs in Docker, so you only need Docker Desktop running.
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "tasks": [
    { "label": "0. Download + unzip IndPenSim data (one-off, ~3 GB)", "type": "shell",
      "command": "docker compose run --rm fetch-data", "problemMatcher": [] },
    { "label": "1. Start Kafka stack (Redpanda + Console)", "type": "shell",
      "command": "docker compose up -d --wait", "problemMatcher": [] },
    { "label": "2. Build images (app + spark)", "type": "shell",
      "command": "docker compose build app spark", "problemMatcher": [] },
    { "label": "3. Register Avro schemas", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.registry register", "problemMatcher": [] },
    { "label": "4a. Generate sample data (100 small batches)", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.sample_data --out out/sample/sample_indpensim.csv", "problemMatcher": [] },
    { "label": "4b. Replay sample data to Kafka", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.replayer --csv out/sample/sample_indpensim.csv", "problemMatcher": [] },
    { "label": "4c. Replay REAL IndPenSim (all 100 batches)", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.replayer --csv data/raw/100_Batches_IndPenSim_V3.csv", "problemMatcher": [] },
    { "label": "4d. Inspect REAL IndPenSim column mapping", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.replayer --csv data/raw/100_Batches_IndPenSim_V3.csv --inspect", "problemMatcher": [] },
    { "label": "4e. Pull openFDA recalls", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.openfda_producer", "problemMatcher": [] },
    { "label": "5. Spark: Kafka -> bronze Delta", "type": "shell",
      "command": "docker compose run --rm spark", "problemMatcher": [] },
    { "label": "6. Phase 1 gate check", "type": "shell",
      "command": "docker compose run --rm app python -m lakehouse.gate_check", "problemMatcher": [] },
    { "label": "Phase 1 gate on sample data (all steps)", "dependsOrder": "sequence",
      "dependsOn": ["1. Start Kafka stack (Redpanda + Console)", "2. Build images (app + spark)", "3. Register Avro schemas",
                    "4a. Generate sample data (100 small batches)", "4b. Replay sample data to Kafka",
                    "5. Spark: Kafka -> bronze Delta", "6. Phase 1 gate check"], "problemMatcher": [] },
    { "label": "Phase 1 gate on REAL IndPenSim data (all steps)", "dependsOrder": "sequence",
      "dependsOn": ["1. Start Kafka stack (Redpanda + Console)", "2. Build images (app + spark)", "3. Register Avro schemas",
                    "4c. Replay REAL IndPenSim (all 100 batches)", "4e. Pull openFDA recalls",
                    "5. Spark: Kafka -> bronze Delta", "6. Phase 1 gate check"], "problemMatcher": [] },

    { "label": "P2-1. Silver: data contracts, quarantine, alerts", "type": "shell",
      "command": "docker compose run --rm spark-silver", "problemMatcher": [] },
    { "label": "P2-2. Gold: batch summary, golden profile, recalls", "type": "shell",
      "command": "docker compose run --rm spark-gold", "problemMatcher": [] },
    { "label": "P2-3. Reconcile: every bronze record accounted for", "type": "shell",
      "command": "docker compose run --rm app python -m lakehouse.reconcile", "problemMatcher": [] },
    { "label": "P2-4a. Drift: inject 10 schema changes (isolated topics)", "type": "shell", "options": { "env": { "GMPDI_TOPIC_SUFFIX": ".driftgate" } }, 
      "command": "docker compose run --rm app python -m drift.inject --csv data/raw/100_Batches_IndPenSim_V3.csv", "problemMatcher": [] },
    { "label": "P2-4b. Drift: bronze", "type": "shell", "options": { "env": { "GMPDI_TOPIC_SUFFIX": ".driftgate" } }, 
      "command": "docker compose run --rm spark --topic all --lakehouse /lakehouse/driftgate", "problemMatcher": [] },
    { "label": "P2-4c. Drift: silver", "type": "shell", "options": { "env": { "GMPDI_TOPIC_SUFFIX": ".driftgate" } }, 
      "command": "docker compose run --rm spark-silver --contract all --lakehouse /lakehouse/driftgate", "problemMatcher": [] },
    { "label": "P2-4d. Drift: gate check", "type": "shell", "options": { "env": { "GMPDI_TOPIC_SUFFIX": ".driftgate" } }, 
      "command": "docker compose run --rm app python -m drift.check", "problemMatcher": [] },
    { "label": "Phase 2: silver + gold + reconcile on REAL data", "dependsOrder": "sequence",
      "dependsOn": ["5. Spark: Kafka -> bronze Delta", "P2-1. Silver: data contracts, quarantine, alerts",
                    "P2-2. Gold: batch summary, golden profile, recalls", "P2-3. Reconcile: every bronze record accounted for"],
      "problemMatcher": [] },
    { "label": "Phase 2 GATE: drift injection on REAL data (all steps)", "dependsOrder": "sequence",
      "dependsOn": ["1. Start Kafka stack (Redpanda + Console)", "2. Build images (app + spark)",
                    "P2-4a. Drift: inject 10 schema changes (isolated topics)", "P2-4b. Drift: bronze",
                    "P2-4c. Drift: silver", "P2-4d. Drift: gate check"], "problemMatcher": [] },
    { "label": "Airflow: start (http://localhost:8090)", "type": "shell",
      "command": "docker compose --profile airflow up -d --wait airflow", "problemMatcher": [] },
    { "label": "Open Airflow UI", "type": "shell",
      "windows": { "command": "Start-Process http://localhost:8090" },
      "osx": { "command": "open http://localhost:8090" },
      "linux": { "command": "xdg-open http://localhost:8090" }, "problemMatcher": [] },

    { "label": "P3-1. Phase 3 GATE: score held-out batches with the frozen detectors", "type": "shell",
      "command": "docker compose run --rm app python -m models.evaluate --source /lakehouse/silver/process_sensor", "problemMatcher": [] },
    { "label": "P3-2. Phase 3: per-episode detection (post-hoc)", "type": "shell",
      "command": "docker compose run --rm app python -m models.episodes --source /lakehouse/silver/process_sensor", "problemMatcher": [] },
    { "label": "P3-3. Phase 3: log frozen detectors to MLflow", "type": "shell",
      "command": "docker compose run --rm app python -m models.train --register-only", "problemMatcher": [] },
    { "label": "P3-4. MLflow UI: start (http://localhost:5000)", "type": "shell",
      "command": "docker compose --profile mlflow up -d mlflow", "problemMatcher": [] },
    { "label": "Open MLflow UI", "type": "shell",
      "windows": { "command": "Start-Process http://localhost:5000" },
      "osx": { "command": "open http://localhost:5000" },
      "linux": { "command": "xdg-open http://localhost:5000" }, "problemMatcher": [] },
    { "label": "Phase 3 (all steps): gate, episodes, MLflow", "dependsOrder": "sequence",
      "dependsOn": ["P3-1. Phase 3 GATE: score held-out batches with the frozen detectors",
                    "P3-2. Phase 3: per-episode detection (post-hoc)", "P3-3. Phase 3: log frozen detectors to MLflow",
                    "P3-4. MLflow UI: start (http://localhost:5000)"], "problemMatcher": [] },

    { "label": "P4-1. Build agent images (LangGraph/LlamaIndex/MCP + CrewAI, ~2 GB once)", "type": "shell",
      "command": "docker compose --profile agents build agents case-historian", "problemMatcher": [] },
    { "label": "P4-2. Build development faults (calibration batches only)", "type": "shell",
      "command": "docker compose --profile agents run --rm --no-deps agents python -m evals.dev_cases --source /lakehouse/silver/process_sensor --out out/dev_cases.parquet",
      "problemMatcher": [] },
    { "label": "P4-3. Start agent services (Postgres, MCP servers, case historian)", "type": "shell",
      "command": "docker compose --profile agents up -d --wait postgres historian historian-dev qms case-historian",
      "problemMatcher": [] },
    { "label": "P4-4. Index regulations into pgvector", "type": "shell",
      "command": "docker compose --profile agents run --rm agents python -m agents.regulatory.retriever index",
      "problemMatcher": [] },
    { "label": "Phase 4 (setup): build, dev faults, services, index", "dependsOrder": "sequence",
      "dependsOn": ["P4-1. Build agent images (LangGraph/LlamaIndex/MCP + CrewAI, ~2 GB once)",
                    "P4-2. Build development faults (calibration batches only)",
                    "P4-3. Start agent services (Postgres, MCP servers, case historian)",
                    "P4-4. Index regulations into pgvector"], "problemMatcher": [] },
    { "label": "P4-dev. One investigation on a development fault (batch 1001)", "type": "shell",
      "command": "docker compose --profile agents run --rm -e HISTORIAN_MCP_URL=http://historian-dev:8111/mcp -e HISTORIAN_SOURCE=/app/out/dev_cases.parquet agents python -m agents.run investigate --batch 1001",
      "problemMatcher": [] },
    { "label": "P4-dev. All development faults (LLM agents)", "type": "shell",
      "command": "docker compose --profile agents run --rm -e HISTORIAN_MCP_URL=http://historian-dev:8111/mcp -e HISTORIAN_SOURCE=/app/out/dev_cases.parquet agents python -m evals.investigations --split dev",
      "problemMatcher": [] },
    { "label": "P4-dev. All development faults (no-LLM rules baseline)", "type": "shell",
      "command": "docker compose --profile agents run --rm -e HISTORIAN_MCP_URL=http://historian-dev:8111/mcp -e HISTORIAN_SOURCE=/app/out/dev_cases.parquet agents python -m evals.investigations --split dev --analyst rules",
      "problemMatcher": [] },
    { "label": "P4-G1. Phase 4 GATE: investigate batches 91-100 ONCE + regulation test questions", "type": "shell",
      "command": "docker compose --profile agents run --rm agents python -m evals.investigations --split test --gate",
      "problemMatcher": [] },
    { "label": "P4-G2. Phase 4: rules baseline on the same batches (pre-registered comparison)", "type": "shell",
      "command": "docker compose --profile agents run --rm agents python -m evals.investigations --split test --analyst rules",
      "problemMatcher": [] },
    { "label": "Phase 4 GATE (all steps): agents, then baseline", "dependsOrder": "sequence",
      "dependsOn": ["P4-G1. Phase 4 GATE: investigate batches 91-100 ONCE + regulation test questions",
                    "P4-G2. Phase 4: rules baseline on the same batches (pre-registered comparison)"],
      "problemMatcher": [] },

    { "label": "Repair schema registry (only if broken: error 40002)", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.registry repair --yes; docker compose restart redpanda; docker compose up -d --wait redpanda; docker compose run --rm app python -m streaming.registry register",
      "problemMatcher": [] },

    { "label": "Live: watch sensor readings (batch 94)", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.tail --batch 94",
      "presentation": { "panel": "dedicated", "group": "live" }, "problemMatcher": [] },
    { "label": "Live: replay fault batch 94 (2 h of plant time per second)", "type": "shell",
      "command": "docker compose run --rm app python -m streaming.replayer --csv data/raw/100_Batches_IndPenSim_V3.csv --batches 94 --speed 7200 --manifest out/manifests/demo_94.json",
      "presentation": { "panel": "dedicated", "group": "live" }, "problemMatcher": [] },
    { "label": "LIVE DEMO: fault batch 94 streaming", "dependsOrder": "parallel",
      "dependsOn": ["Live: watch sensor readings (batch 94)", "Live: replay fault batch 94 (2 h of plant time per second)"],
      "problemMatcher": [] },
    { "label": "Spark: stream continuously into bronze", "type": "shell",
      "command": "docker compose run --rm spark --trigger continuous",
      "presentation": { "panel": "dedicated" }, "problemMatcher": [] },
    { "label": "Open Redpanda Console (topics, schemas, messages)", "type": "shell",
      "windows": { "command": "Start-Process http://localhost:8080" },
      "osx": { "command": "open http://localhost:8080" },
      "linux": { "command": "xdg-open http://localhost:8080" }, "problemMatcher": [] },

    { "label": "Setup: local Python venv for tests", "type": "shell",
      "windows": { "command": "python -m venv .venv; .venv\\Scripts\\python -m pip install -e '.[lakehouse,dev]'" },
      "command": "python3 -m venv .venv && .venv/bin/python -m pip install -e '.[lakehouse,dev]'", "problemMatcher": [] },
    { "label": "Run tests", "type": "shell", "group": { "kind": "test", "isDefault": true },
      "windows": { "command": ".venv\\Scripts\\python -m pytest -q" },
      "command": ".venv/bin/python -m pytest -q", "problemMatcher": [] },
    { "label": "Stop stack (keep data)", "type": "shell", "command": "docker compose --profile airflow --profile mlflow --profile agents down", "problemMatcher": [] },
    { "label": "Reset stack (DELETES topics and bronze tables)", "type": "shell", "command": "docker compose --profile airflow down -v", "problemMatcher": [] }
  ]
}
